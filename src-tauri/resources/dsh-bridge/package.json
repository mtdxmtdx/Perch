{
  "name": "perch-dsh-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "把 DeepSeek Harness 的会话状态转发给 Perch 桌宠",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "config.json", "cordis.patch.yml", "locale/*.json"],
  "keywords": ["dsh-plugin"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
